{
  "expo": {
    "name": "Mizan",
    "slug": "money-tracker",
    "scheme": "moneytracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.moneytracker.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundColor": "#207D68"
      }
    },
    "ios": {
      "bundleIdentifier": "com.moneytracker.app",
      "infoPlist": {}
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sqlite"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": true,
      "eas": {
        "projectId": "ce4f34bf-57e6-4189-b2ca-31507a4941e6"
      }
    },
    "owner": "ziadmhmd"
  }
}
