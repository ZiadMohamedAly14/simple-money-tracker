# Copy to .env for local development. Every variable is checked at start-up (src/config/env.ts).
NODE_ENV=development
PORT=4000
# Local: mongodb://127.0.0.1:27017/money-tracker
# Production: the Atlas M0 connection string (separate organization from another project, ADR-0008)
MONGODB_URI=mongodb://127.0.0.1:27017/money-tracker
# Database name on the cluster (overrides any name in MONGODB_URI). Defaults to money-tracker.
DB_NAME=money-tracker

# Token and code secrets: at least 32 characters each, all different.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789
CODE_HASH_SECRET=dev-code-hash-secret-change-me-0123456789

# Email. Production: Resend's HTTPS API (Railway Hobby blocks outbound SMTP), so set RESEND_API_KEY.
# When RESEND_API_KEY is set it is used in any environment; otherwise SMTP below is used.
RESEND_API_KEY=
# Development: SMTP to a local catcher, e.g. Mailpit
#   docker run --rm -p 1025:1025 -p 8025:8025 axllent/mailpit   (inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Production: on a domain verified in Resend, or `Mizan <onboarding@resend.dev>` with no
# domain (Resend then only delivers to the Resend account owner's address).
EMAIL_FROM=Mizan <no-reply@localhost>
